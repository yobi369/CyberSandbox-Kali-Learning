# Copy this file to .env and replace both values with long random alphanumeric secrets.
# Keep .env private; never commit it.
POSTGRES_PASSWORD=replace-with-a-unique-random-password-at-least-32-characters
CYBERSANDBOX_APP_PASSWORD=replace-with-a-different-unique-random-password-at-least-48-characters

# Optional absolute API origin for the separate public demo. Leave blank for the local Vite proxy.
VITE_API_ORIGIN=
